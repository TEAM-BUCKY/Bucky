# Copy to .env and fill in before `docker compose up -d`.

# Public domain pointed at this VPS (DNS A/AAAA record → server IP).
# Used by Traefik for routing and Let's Encrypt certificates.
DOMAIN=bucky.example.com

# Email for Let's Encrypt registration / expiry notices.
ACME_EMAIL=you@example.com

# Credentials that gate CONTROL actions (launching / stopping jobs). The site stays
# publicly viewable without these; only control requires logging in with them.
APP_USERNAME=admin
APP_PASSWORD=change-me-please

# Shared secret the trainer subprocess uses to reach the internal ingest endpoint.
# Generate one with:  openssl rand -hex 32
INGEST_TOKEN=change-me-too

# Optional: restrict allowed browser origins for the public read endpoints (default *).
# CORS_ORIGINS=https://bucky.example.com
