# Copy to .env and fill in before `docker compose up -d --build`.
#
# This stack rides on a SHARED, already-running Traefik attached to the external
# `traefik_public` network. Create that network once if it does not exist:
#   docker network create traefik_public
# The shared Traefik owns ports 80/443, the ACME email, and the `leresolver` resolver.

# Public domain pointed at this VPS (DNS A/AAAA record -> server IP).
# Used in the Traefik Host() routing rules.
DOMAIN=bucky.example.com

# ── Control auth ──────────────────────────────────────────────────────────────
# Two mutually-exclusive ways to gate CONTROL actions (launching / stopping jobs).
# The site stays publicly viewable either way; only control requires logging in.
#
# 1) GitHub-org OAuth (recommended for the team). When CLIENT_ID + SECRET + ORG are
#    all set, control switches to "Sign in with GitHub" and any member of GITHUB_ORG
#    may control the server. The shared password below is then IGNORED.
#    Create an OAuth app at https://github.com/settings/developers with
#    Authorization callback URL:  https://${DOMAIN}/api/auth/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ORG=Bucky
# PUBLIC_URL is the externally-reachable base URL; required so the OAuth redirect is
# built correctly behind the TLS proxy. Use https://${DOMAIN}.
# PUBLIC_URL=https://bucky.example.com
# Optional: how long a browser login lasts (days). Default 14.
# SESSION_TTL_DAYS=14

# 2) Shared password (the fallback used when GitHub OAuth is NOT configured — handy
#    for local dev). Ignored once OAuth is enabled.
APP_USERNAME=admin
APP_PASSWORD=change-me-please

# Shared secret the trainer subprocess uses to reach the internal ingest endpoint.
# Generate one with:  openssl rand -hex 32
INGEST_TOKEN=change-me-too

# Optional: restrict allowed browser origins for the public read endpoints (default *).
# CORS_ORIGINS=https://bucky.example.com
