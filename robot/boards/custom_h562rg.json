{
  "build": {
    "core": "stm32",
    "cpu": "cortex-m33",
    "extra_flags": "-DSTM32H562xx -DSTM32H5xx -DSTM32H5",
    "f_cpu": "250000000L",
    "framework_extra_flags": {
      "arduino": "-D ARDUINO_GENERIC_H562RGTX"
    },
    "mcu": "stm32h562rgt6",
    "product_line": "STM32H562xx",
    "variant": "STM32H5xx/H562R(G-I)T",
